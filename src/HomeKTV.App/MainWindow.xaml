<Window x:Class="HomeKTV.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HomeKTV 家庭点歌台" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="94" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#0F1220" BorderBrush="#24283A" BorderThickness="0,0,1,0">
                <Grid Margin="18,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="H" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,3,0,0"><TextBlock Text="HomeKTV" FontSize="19" FontWeight="Bold"/><TextBlock Text="家庭欢唱中心" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Border Background="#1A1D2C" CornerRadius="14" Padding="13" Margin="0,8">
                            <StackPanel><TextBlock Text="手机点歌地址" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding ServerAddress}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/></StackPanel>
                        </Border>
                        <Button Content="打开手机点歌二维码" Command="{Binding ShowQrCommand}"/>
                        <TextBlock Text="数据均保存在当前便携目录" Foreground="#606579" FontSize="10" Margin="8,9"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="24,18,24,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="家庭点歌台" FontSize="27" FontWeight="Bold"/><TextBlock Text="搜歌、排队、播放和设备状态都在这里" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource GhostButton}" Content="打开大屏" Command="{Binding OpenPlayerCommand}"/><Button Content="导入歌曲" Command="{Binding ImportCommand}"/></StackPanel>
                </Grid>
                <TabControl Grid.Row="1" Margin="0,16,0,0" Background="Transparent" BorderThickness="0">
                    <TabItem Header="首页 / 搜索">
                        <Grid Margin="4,14,4,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" ToolTip="支持歌名、歌手、拼音全拼、首字母和别名"/>
                                <ComboBox Grid.Column="1" Margin="10,0" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/>
                                <Button Grid.Column="2" Content="搜索" Command="{Binding SearchCommand}"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="2,16,2,8"><TextBlock Text="歌曲结果" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Songs.Count,StringFormat={}{0} 首}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid>
                            <ListBox Grid.Row="2" ItemsSource="{Binding Songs}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,0,0,7"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelBrush}" CornerRadius="15" Padding="13">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="13" Background="#2C2744"><TextBlock Text="♫" FontSize="20" Foreground="#D3C3FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding ArtistDisplayName}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel>
                                                <Border Grid.Column="2" CornerRadius="10" Background="#232638" Margin="6"><TextBlock Text="{Binding Language}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BABED0"/></Border>
                                                <Button Grid.Column="3" Content="点歌" Command="{Binding DataContext.EnqueueCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="已点队列">
                        <Grid Margin="4,14,4,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <Grid><TextBlock Text="已点歌曲" FontSize="20" FontWeight="Bold"/><Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Content="清空待播" Command="{Binding ClearQueueCommand}"/></Grid>
                            <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding QueueItems}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,7"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelBrush}" CornerRadius="15" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Position}" FontSize="18" Foreground="#696F86" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Song.Title}" FontSize="15"/><TextBlock Text="{Binding Song.ArtistDisplayName}" Foreground="{StaticResource MutedBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding RequestedBy,StringFormat={}点歌人：{0}}" Foreground="#B4A7E8" VerticalAlignment="Center"/><Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="删除" Command="{Binding DataContext.DeleteQueueCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="导入 / 媒体">
                        <Grid Margin="6,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="28" Margin="0,0,9,0"><StackPanel><TextBlock Text="导入一首 MV" FontSize="23" FontWeight="Bold"/><TextBlock Text="选择 MP4、MKV、AVI 或 MOV。文件会安全复制到便携版 Media/MV，原文件不会被修改。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="23" Margin="0,12,0,24"/><Button Content="选择本地 MV" Command="{Binding ImportCommand}" HorizontalAlignment="Left"/><TextBlock Text="也可以把“歌手 - 歌名.mp4 / .lrc / .jpg”放入 Media/ImportBox。" Foreground="#787E94" TextWrapping="Wrap" Margin="0,22,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="28" Margin="9,0,0,0"><StackPanel><TextBlock Text="媒体健康检查" FontSize="23" FontWeight="Bold"/><TextBlock Text="检查文件缺失和可访问性；FFprobe 可读取封装、编码、分辨率、帧率与音轨。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="23" Margin="0,12,0,24"/><TextBlock Text="{Binding AvailableSongCount,StringFormat={}可用媒体：{0} 首}" FontSize="16"/><TextBlock Text="{Binding SongCount,StringFormat={}歌曲总数：{0} 首}" Foreground="{StaticResource MutedBrush}" Margin="0,7"/><Button Content="立即检查" Command="{Binding InspectMediaCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="设置 / 维护">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="6,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="25" Margin="0,0,9,0"><StackPanel><TextBlock Text="播放与队列" FontSize="21" FontWeight="Bold"/><TextBlock Text="默认音量" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,5"/><Slider Minimum="0" Maximum="125" Value="{Binding Volume}"/><CheckBox Content="大屏默认全屏" IsChecked="{Binding Settings.PlaybackFullscreen}" Margin="0,18,0,8"/><CheckBox Content="大屏显示手机二维码" IsChecked="{Binding Settings.ShowQrCode}" Margin="0,8"/><TextBlock Text="歌词同步" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,6"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource GhostButton}" Content="提前 100ms" Command="{Binding LyricsEarlierCommand}"/><Button Style="{StaticResource GhostButton}" Content="延后 100ms" Command="{Binding LyricsLaterCommand}"/></StackPanel></StackPanel></Border>
                                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="25" Margin="9,0,0,0"><StackPanel><TextBlock Text="网络与数据" FontSize="21" FontWeight="Bold"/><CheckBox Content="允许局域网手机点歌" IsChecked="{Binding Settings.LanModeEnabled}" Margin="0,20,0,8"/><TextBlock Text="服务端口" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Settings.ServerPort}" Margin="0,5,0,12"/><TextBlock Text="管理员 PIN" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Settings.AdministratorPin}" Margin="0,5,0,14"/><Button Content="保存设置" Command="{Binding SaveSettingsCommand}"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Style="{StaticResource GhostButton}" Content="备份数据库" Command="{Binding BackupCommand}"/><Button Style="{StaticResource GhostButton}" Content="恢复数据库" Command="{Binding RestoreCommand}"/></StackPanel></StackPanel></Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="日志 / 诊断">
                        <Border Margin="6,18" Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="28"><StackPanel><TextBlock Text="运行状态与诊断" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding StatusMessage}" FontSize="16" Margin="0,18,0,6"/><TextBlock Text="详细异常堆栈写入 Logs/HomeKTV-日期.log。手机无法访问时，请确认同一 Wi-Fi、当前 IP/端口和 Windows 专用网络防火墙规则。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="24"/><Border Background="#10121D" CornerRadius="14" Padding="18" Margin="0,24,0,0"><StackPanel><TextBlock Text="手机访问地址" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ServerAddress}" FontSize="20" FontWeight="SemiBold" Margin="0,7"/><TextBlock Text="服务器运行中 · SQLite FULL 同步 · 媒体使用便携相对路径" Foreground="#6DDAAD"/></StackPanel></Border></StackPanel></Border>
                    </TabItem>
                </TabControl>
                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="4,8,0,0"/>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Background="#111421" BorderBrush="#272B3E" BorderThickness="0,1,0,0">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Border Width="62" Height="62" CornerRadius="16" Background="#392C58"><TextBlock Text="▶" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F1B1D0"/></Border><StackPanel Margin="14,7,0,0"><TextBlock Text="{Binding CurrentTitle}" FontSize="17" FontWeight="Bold"/><TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"><Run Text="{Binding CurrentArtist}"/><Run Text="  ·  "/><Run Text="{Binding CurrentRequester}"/></TextBlock></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource GhostButton}" Content="重唱" Command="{Binding RestartCommand}"/><Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" MinWidth="70"/><Button Style="{StaticResource GhostButton}" Content="切歌" Command="{Binding SkipCommand}"/><Button Style="{StaticResource GhostButton}" Content="原唱" Command="{Binding OriginalCommand}"/><Button Style="{StaticResource GhostButton}" Content="伴奏" Command="{Binding AccompanimentCommand}"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center"><Grid><TextBlock Text="主音量" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Volume}" HorizontalAlignment="Right"/></Grid><Slider Minimum="0" Maximum="125" Value="{Binding Volume}" Margin="0,8,0,0"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
