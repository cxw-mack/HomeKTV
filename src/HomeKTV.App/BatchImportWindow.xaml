<Window x:Class="HomeKTV.App.BatchImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量导入确认" Width="1240" Height="720" MinWidth="920" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="确认歌曲文件夹" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="歌手和歌曲名可直接修改；缺少歌词的歌曲仍可正常导入。"
                       Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource GhostButton}" Content="全选" Click="SelectAll_Click"/>
            <Button Style="{StaticResource GhostButton}" Content="清空选择" Click="ClearSelection_Click"/>
            <Button Style="{StaticResource GhostButton}" Content="只选完整项目" Click="SelectComplete_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="CandidateGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  FrozenColumnCount="3" Background="#111421" Foreground="White" RowBackground="#171A29"
                  AlternatingRowBackground="#1D2031" BorderBrush="#39415D" BorderThickness="1"
                  CurrentCellChanged="CandidateGrid_CurrentCellChanged">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="导入" Binding="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                <DataGridTextColumn Header="状态" Binding="{Binding RecognitionStatus}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="歌手" Binding="{Binding Artist,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                <DataGridTextColumn Header="歌曲名" Binding="{Binding Title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="210"/>
                <DataGridTextColumn Header="分类" Binding="{Binding Language,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="原唱 / 主媒体" Binding="{Binding PrimaryFileName}" IsReadOnly="True" Width="250"/>
                <DataGridTextColumn Header="伴奏" Binding="{Binding AccompanimentFileName}" IsReadOnly="True" Width="230"/>
                <DataGridTextColumn Header="歌词" Binding="{Binding LyricFileName}" IsReadOnly="True" Width="190"/>
                <DataGridTextColumn Header="来源文件夹" Binding="{Binding SourceFolderName}" IsReadOnly="True" Width="190"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click"/>
                <Button Content="导入已勾选歌曲" Click="Import_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
