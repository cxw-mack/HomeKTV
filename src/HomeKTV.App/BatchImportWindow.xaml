<Window x:Class="HomeKTV.App.BatchImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量导入确认" Width="980" Height="650" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="确认待导入歌曲" FontSize="26" FontWeight="Bold"/><TextBlock Text="取消勾选不需要的项目；确认后才会复制媒体并写入数据库。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14"/></StackPanel>
        <DataGrid Grid.Row="1" x:Name="CandidateGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="#111421" Foreground="White" RowBackground="#171A29" AlternatingRowBackground="#1D2031">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="导入" Binding="{Binding IsSelected,Mode=TwoWay}" Width="64"/>
                <DataGridTextColumn Header="歌手" Binding="{Binding Artist}" Width="180"/>
                <DataGridTextColumn Header="歌曲名" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="语言" Binding="{Binding Language}" Width="90"/>
                <DataGridTextColumn Header="歌词" Binding="{Binding LyricPath}" Width="210"/>
                <DataGridTextColumn Header="封面" Binding="{Binding CoverPath}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click"/><Button Content="导入已勾选项目" Click="Import_Click"/></StackPanel></Grid>
    </Grid>
</Window>
