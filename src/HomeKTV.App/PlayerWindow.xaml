<Window x:Class="HomeKTV.App.PlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="HomeKTV 大屏" Width="1280" Height="720" MinWidth="800" MinHeight="450" Background="Black" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <Grid Background="Black">
        <vlc:VideoView x:Name="VideoView">
            <Grid>
                <Grid x:Name="SlideshowLayer" Visibility="Collapsed" Background="#080913">
                    <Image x:Name="SlideBackground" Stretch="UniformToFill" Opacity="0.72"><Image.Effect><BlurEffect Radius="32"/></Image.Effect></Image>
                    <Border x:Name="SlideMask" Background="Black" Opacity="0.12"/>
                    <Image x:Name="SlideImageA" Stretch="Uniform" Opacity="0" Margin="18"/>
                    <Image x:Name="SlideImageB" Stretch="Uniform" Opacity="0" Margin="18"/>
                </Grid>
                <Grid x:Name="PlaybackOverlay" TextElement.Foreground="White">
                    <Border x:Name="TopInfoPanel" VerticalAlignment="Top" Background="#B20A0B14" Padding="28,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="SongInformationPanel"><TextBlock Text="{Binding CurrentTitle}" FontSize="28" FontWeight="Bold"/><TextBlock FontSize="14" Foreground="#C5C8D4" Margin="0,6,0,0"><Run Text="{Binding CurrentArtist}"/><Run Text="   ·   "/><Run Text="点歌："/><Run Text="{Binding CurrentRequester}"/></TextBlock></StackPanel><StackPanel x:Name="NextSongPanel" Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="下一首" Foreground="#9CA1B4" HorizontalAlignment="Right"/><TextBlock Text="{Binding NextTitle}" FontSize="18" Margin="0,5,0,0"/></StackPanel></Grid></Border>
                    <Border x:Name="LyricsPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="1000" Margin="0,0,0,54" Padding="28,12" CornerRadius="6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="TopLyric" TextAlignment="Left" FontSize="42" FontWeight="Bold" Foreground="White" Effect="{DynamicResource LyricShadow}" Margin="0,5" TextWrapping="Wrap"/><TextBlock x:Name="BottomLyric" Grid.Row="1" TextAlignment="Right" FontSize="42" FontWeight="Bold" Foreground="White" Effect="{DynamicResource LyricShadow}" Margin="0,5" TextWrapping="Wrap"/></Grid></Border>
                    <Border x:Name="QrPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#EFFFFFFF" CornerRadius="12" Padding="8" Margin="0,0,22,22"><StackPanel><Image x:Name="QrImage" Width="92" Height="92"/><TextBlock Text="扫码点歌" Foreground="#202233" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border>
                </Grid>
                <Grid x:Name="IdlePanel" Background="#151526" TextElement.Foreground="White">
                    <Image x:Name="IdleBackgroundImage" Stretch="UniformToFill" Opacity="0.75"/>
                    <Border Background="#52000000"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="HomeKTV" FontSize="56" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="等待点歌" FontSize="24" Foreground="#D7D9E5" HorizontalAlignment="Center" Margin="0,14,0,0"/></StackPanel>
                    <Border x:Name="IdleQrPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#EFFFFFFF" CornerRadius="12" Padding="8" Margin="0,0,22,22"><StackPanel><Image x:Name="IdleQrImage" Width="110" Height="110"/><TextBlock Text="扫码点歌" Foreground="#202233" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Border>
                </Grid>
            </Grid>
        </vlc:VideoView>
    </Grid>
</Window>
