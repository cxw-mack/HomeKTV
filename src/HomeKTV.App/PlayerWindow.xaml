<Window x:Class="HomeKTV.App.PlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="HomeKTV 大屏" Width="1280" Height="720" MinWidth="800" MinHeight="450" Background="Black" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <Grid Background="Black">
        <vlc:VideoView x:Name="VideoView">
            <Grid>
                <Border VerticalAlignment="Top" Background="#B20A0B14" Padding="28,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CurrentTitle}" FontSize="28" FontWeight="Bold"/><TextBlock FontSize="14" Foreground="#C5C8D4" Margin="0,6,0,0"><Run Text="{Binding CurrentArtist}"/><Run Text="   ·   "/><Run Text="点歌："/><Run Text="{Binding CurrentRequester}"/></TextBlock></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="下一首" Foreground="#9CA1B4" HorizontalAlignment="Right"/><TextBlock Text="{Binding NextTitle}" FontSize="18" Margin="0,5,0,0"/></StackPanel></Grid></Border>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="900" Margin="0,0,0,54"><TextBlock x:Name="PreviousLyric" TextAlignment="Center" FontSize="24" Foreground="#88FFFFFF" Margin="0,5"/><TextBlock x:Name="CurrentLyric" TextAlignment="Center" FontSize="36" FontWeight="Bold" Foreground="#FFFF75A0" Effect="{DynamicResource LyricShadow}" Margin="0,8"/><TextBlock x:Name="NextLyric" TextAlignment="Center" FontSize="24" Foreground="#88FFFFFF" Margin="0,5"/></StackPanel>
                <Border x:Name="QrPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#EFFFFFFF" CornerRadius="12" Padding="8" Margin="0,0,22,22"><StackPanel><Image x:Name="QrImage" Width="92" Height="92"/><TextBlock Text="扫码点歌" Foreground="#202233" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</Window>

