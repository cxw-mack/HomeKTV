<Window x:Class="HomeKTV.App.QrCodeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="手机扫码点歌" Width="520" Height="720" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="390"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="手机扫码点歌" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="安卓和 iPhone 均可用系统相机扫描，请连接与电脑相同的 Wi-Fi" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8"/></StackPanel><Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="28"><Image x:Name="QrImage" Stretch="Uniform"/></Border><StackPanel Grid.Row="2"><TextBlock x:Name="AddressText" HorizontalAlignment="Center" FontSize="15"/><TextBlock x:Name="FallbackText" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="扫码后打不开时，先在电脑上配置一次 Windows 手机访问；手机用户无需管理员权限。" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button Style="{StaticResource GhostButton}" Content="复制地址" Click="CopyAddress_Click"/><Button x:Name="ConfigureButton" Content="配置 Windows 手机访问" Click="ConfigureAccess_Click" Margin="8,0,0,0"/></StackPanel></StackPanel></Grid>
</Window>
