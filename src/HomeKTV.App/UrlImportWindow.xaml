<Window x:Class="HomeKTV.App.UrlImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HTTP/HTTPS 直链导入" Width="620" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="合法直链媒体导入" FontSize="24" FontWeight="Bold"/><TextBlock Text="仅用于你明确提供且拥有合法访问权的直接视频文件 URL；不支持视频网站解析、登录绕过或 DRM。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock Text="视频 URL"/><TextBox x:Name="UrlBox" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="歌曲名"/><TextBox x:Name="TitleBox" Margin="0,5"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="歌手"/><TextBox x:Name="ArtistBox" Margin="0,5"/></StackPanel></Grid><TextBlock Text="语言" Margin="0,10,0,4"/><ComboBox x:Name="LanguageBox" SelectedIndex="3"><ComboBoxItem Content="华语"/><ComboBoxItem Content="粤语"/><ComboBoxItem Content="英文"/><ComboBoxItem Content="其他"/></ComboBox><ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="100" Margin="0,22,0,5"/><TextBlock x:Name="StatusText" Text="等待开始" Foreground="{StaticResource MutedBrush}"/></StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click"/><Button x:Name="StartButton" Content="开始下载并导入" Click="Start_Click"/></StackPanel>
    </Grid>
</Window>
