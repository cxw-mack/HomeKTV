<Window x:Class="HomeKTV.App.ImportSongWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="确认歌曲信息" Width="520" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="确认歌曲信息" FontSize="25" FontWeight="Bold"/><TextBlock Text="同名的 LRC 和 JPG/PNG 会自动一起导入。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Row="1" Margin="0,24,0,0"><TextBlock Text="歌曲名" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="TitleBox" Margin="0,6,0,14"/><TextBlock Text="歌手" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="ArtistBox" Margin="0,6,0,14"/><TextBlock Text="语言 / 分类" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="LanguageBox" SelectedIndex="4" Margin="0,6,0,14"><ComboBoxItem Content="华语"/><ComboBoxItem Content="粤语"/><ComboBoxItem Content="英文"/><ComboBoxItem Content="其他"/></ComboBox><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="原唱音轨（可空）" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="OriginalBox" Margin="0,6"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="伴奏音轨（可空）" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="AccompanimentBox" Margin="0,6"/></StackPanel></Grid></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click"/><Button Content="开始导入" Click="Import_Click"/></StackPanel></Grid>
</Window>

