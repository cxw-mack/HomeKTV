<Window x:Class="HomeKTV.App.ImportSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认歌曲信息" Width="700" Height="820" MinWidth="620" MinHeight="720"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="34">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="确认歌曲信息" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="可同时导入歌曲媒体和独立伴奏；同名 LRC/TXT 与封面会自动匹配。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" FontSize="14"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,26,0,18">
            <StackPanel>
                <TextBlock Text="歌曲名" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/>
                <TextBox x:Name="TitleBox" MinHeight="64" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>
                <TextBlock Text="歌手" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/>
                <TextBox x:Name="ArtistBox" Margin="0,0,0,20"/>
                <TextBlock Text="语言 / 分类" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/>
                <ComboBox x:Name="LanguageBox" SelectedIndex="3" Margin="0,0,0,22">
                    <ComboBoxItem Content="华语"/><ComboBoxItem Content="粤语"/><ComboBoxItem Content="英文"/><ComboBoxItem Content="其他"/>
                </ComboBox>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="原唱音轨（可空）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><TextBox x:Name="OriginalBox"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="伴奏音轨（可空）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><TextBox x:Name="AccompanimentBox"/></StackPanel>
                </Grid>
                <TextBlock Text="独立伴奏文件（可空）" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="AccompanimentPathBox" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="支持音频和视频文件"/>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="选择伴奏" Click="ChooseAccompaniment_Click" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="清除" Click="ClearAccompaniment_Click" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="音频伴奏保留原格式；视频伴奏会提取音轨并与歌曲时间线同步。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="同步歌词文件（可空）" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="LyricPathBox" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="支持带时间标签的 LRC 或 TXT 歌词"/>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="选择歌词" Click="ChooseLyric_Click" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="清除" Click="ClearLyric_Click" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="歌词应包含 [分:秒.毫秒] 时间标签；同名歌词会自动填入，也可以在这里手动更换。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="纯音频幻灯片图片（可空）" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SlideshowPathBox" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="支持 JPG、PNG、WEBP 和 BMP，可多选"/>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="选择图片" Click="ChooseSlideshow_Click" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="清除" Click="ClearSlideshow_Click" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="纯音频播放时会随机轮播所选图片；未选择时使用封面、同目录图片或程序默认背景。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}" Content="取消" MinWidth="92" Click="Cancel_Click"/>
            <Button Content="开始导入" MinWidth="124" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
