<Window x:Class="HomeKTV.App.SlideshowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="纯音频幻灯片编辑" Width="1180" Height="780" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="340"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="纯音频幻灯片" FontSize="26" FontWeight="Bold"/><TextBlock Text="图片会复制到歌曲自己的便携目录；删除、移动或换盘后仍可使用。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
            <ComboBox x:Name="SongBox" Grid.Column="1" ItemsSource="{Binding AudioSongs}" DisplayMemberPath="Title" SelectionChanged="SongBox_SelectionChanged" Margin="12,0"/>
            <Button Grid.Column="2" Content="重新加载" Click="Reload_Click"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width=".85*"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,8"><Button Content="添加图片…" Click="AddFiles_Click"/><Button Style="{StaticResource GhostButton}" Content="添加文件夹…" Click="AddFolder_Click"/><Button Style="{StaticResource GhostButton}" Content="上移" Click="MoveUp_Click"/><Button Style="{StaticResource GhostButton}" Content="下移" Click="MoveDown_Click"/><Button Style="{StaticResource GhostButton}" Content="删除" Click="Delete_Click"/><Button Style="{StaticResource GhostButton}" Content="设为封面" Click="SetCover_Click"/><Button Style="{StaticResource GhostButton}" Content="左转" Click="RotateLeft_Click"/><Button Style="{StaticResource GhostButton}" Content="右转" Click="RotateRight_Click"/></WrapPanel>
                <ListBox x:Name="ImageList" Grid.Row="1" ItemsSource="{Binding Images}" SelectionChanged="ImageList_SelectionChanged" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="8" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding AbsolutePath}" Width="78" Height="54" Stretch="UniformToFill"/><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding RelativePath}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Foreground="#858BA2" FontSize="10"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            </Grid>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="14,0,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition/></Grid.RowDefinitions>
                    <Border Background="Black" CornerRadius="10" ClipToBounds="True"><Grid><Image x:Name="PreviewImage" Stretch="Uniform"/><TextBlock x:Name="EmptyPreviewText" Text="选择图片预览" Foreground="#88909F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0">
                        <TextBlock Text="播放参数" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="切换间隔（秒）" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,3"/><TextBox x:Name="IntervalBox" Text="8"/>
                        <TextBlock Text="切换效果" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,3"/><ComboBox x:Name="TransitionBox" ItemsSource="{Binding Transitions}"/>
                        <TextBlock Text="图片适配" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,3"/><ComboBox x:Name="FitBox" ItemsSource="{Binding FitModes}"/>
                        <TextBlock Text="歌词位置" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,3"/><ComboBox x:Name="LyricPositionBox" ItemsSource="{Binding LyricPositions}"/>
                        <WrapPanel Margin="0,10,0,0"><CheckBox x:Name="ShuffleBox" Content="随机"/><CheckBox x:Name="LoopBox" Content="循环" Margin="14,0,0,0"/><CheckBox x:Name="CoverFirstBox" Content="封面优先" Margin="14,0,0,0"/></WrapPanel>
                        <WrapPanel Margin="0,8,0,0"><CheckBox x:Name="ShowLyricsBox" Content="显示歌词"/><CheckBox x:Name="ShowInfoBox" Content="歌曲信息" Margin="14,0,0,0"/><CheckBox x:Name="ShowNextBox" Content="下一首" Margin="14,0,0,0"/></WrapPanel>
                        <TextBlock Text="模糊半径" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,3"/><Slider x:Name="BlurSlider" Minimum="0" Maximum="100" TickFrequency="1"/>
                        <TextBlock Text="图片遮罩" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,3"/><Slider x:Name="MaskSlider" Minimum="0" Maximum="0.9" TickFrequency="0.05"/>
                        <Button Style="{StaticResource GhostButton}" Content="恢复程序默认背景" Click="RestoreDefaults_Click" Margin="0,12,0,0"/>
                    </StackPanel></ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="关闭" Click="Close_Click"/><Button Content="保存配置" Click="Save_Click"/></StackPanel></Grid>
    </Grid>
</Window>
